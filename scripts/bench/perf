#!/usr/bin/env python3
"""Performance baseline for the three mfile run modes.

  (a) GOAMD64=v1
  (b) GOEXPERIMENT=simd GOAMD64=v1
  (c) the (b) binary with GODEBUG=simd=0

Also reports a supplemental sandy-like run (GODEBUG=simd=0 plus
GOMLX_GO_SIMD_AVX2=0 and GOMLX_GO_SIMD_AVX512=0). gomlx's AVX kernels follow
those variables and CPUID, not GODEBUG, so on an AVX-512 host (c) is not the
Sandy Bridge kernel mix.

Cold-start times are hyperfine means of single-file process invocations with
one warmup (page cache warm, graph compile still happens every process).
Graph compile vs inference is split from `mfile -stats`: ScanAll(1) is
compile+infer, ScanAll(N) is compile+N*infer.

The large corpus is generated by gen_large.py and is not committed.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import statistics
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import common


def find_hyperfine() -> str:
    override = os.environ.get("HYPERFINE")
    if override:
        return override
    from shutil import which

    found = which("hyperfine")
    if found:
        return found
    candidate = Path.home() / ".local" / "bin" / "hyperfine"
    if candidate.exists():
        return str(candidate)
    raise SystemExit("hyperfine not found; install it or set HYPERFINE")


def hyperfine(command: str, export: Path, runs: int) -> dict:
    binary = find_hyperfine()
    export.parent.mkdir(parents=True, exist_ok=True)
    proc = subprocess.run(
        [
            binary,
            "--warmup",
            "1",
            "--runs",
            str(runs),
            "--export-json",
            str(export),
            command,
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    if proc.returncode != 0:
        raise SystemExit(f"hyperfine failed:\n{proc.stdout}")
    data = json.loads(export.read_text(encoding="utf-8"))
    result = data["results"][0]
    return {
        "mean_s": result["mean"],
        "stddev_s": result["stddev"],
        "median_s": result["median"],
        "min_s": result["min"],
        "max_s": result["max"],
    }


def shell_prefix(extra: dict[str, str] | None) -> str:
    if not extra:
        return ""
    return " ".join(f"{key}={shlex.quote(value)}" for key, value in extra.items()) + " "


def median(values: list[float]) -> float:
    return statistics.median(values)


def startup_split(binary: Path, sample: Path, extra: dict[str, str] | None, reps: int, many: int) -> dict:
    one_scan, one_load, one_rss = [], [], []
    many_scan = []
    for _ in range(reps):
        _results, err, rc = common.run_mfile(binary, [sample], extra_env=extra, stats=True)
        if rc != 0:
            raise SystemExit(f"stats run failed:\n{err}")
        stats = common.parse_stats(err)
        one_scan.append(float(stats["scan_all_s"]))
        one_load.append(float(stats["new_scanner_s"]))
        one_rss.append(float(stats.get("peak_rss_mib", 0)))
        _results, err, rc = common.run_mfile(binary, [sample] * many, extra_env=extra, stats=True)
        if rc != 0:
            raise SystemExit(f"stats run failed:\n{err}")
        many_scan.append(float(common.parse_stats(err)["scan_all_s"]))
    scan1 = median(one_scan)
    scan_n = median(many_scan)
    infer = (scan_n - scan1) / (many - 1)
    compile_s = scan1 - infer
    return {
        "new_scanner_s": median(one_load),
        "scan1_s": scan1,
        "scan_n_s": scan_n,
        "n": many,
        "infer_s": infer,
        "compile_s": compile_s,
        "peak_rss_mib_one": median(one_rss),
    }


def fmt_s(value: float) -> str:
    if value < 1:
        return f"{value * 1000:.1f} ms"
    return f"{value:.3f} s"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--rebuild", action="store_true")
    parser.add_argument("--large", type=Path, default=Path("/tmp/mfile-bench-large"))
    parser.add_argument("--small", type=int, default=12000)
    parser.add_argument("--matrix-n", type=int, default=2000)
    parser.add_argument("--runs", type=int, default=10)
    parser.add_argument("--skip-matrix", action="store_true")
    args = parser.parse_args()

    env = common.environment()
    print("# environment")
    for key, value in env.items():
        print(f"- {key}: {value}")
    print()

    v1, simd = common.ensure_clis(rebuild=args.rebuild)
    sample = common.corpus_dir() / "code" / "hello.go"
    if not sample.exists():
        raise SystemExit(f"missing {sample}; run gen_corpus.py")

    modes = [
        ("v1", v1, None),
        ("simd", simd, None),
        ("simd_off", simd, common.SIMD_OFF),
        ("sandy_like", simd, common.SANDY_LIKE),
    ]

    print("# binary size")
    print(f"- v1: {v1.stat().st_size} bytes ({v1.stat().st_size / (1024 * 1024):.2f} MiB)")
    print(f"- simd: {simd.stat().st_size} bytes ({simd.stat().st_size / (1024 * 1024):.2f} MiB)")
    print()

    print("# single-file cold start (hyperfine, warmup 1, graph recompiled every run)")
    cold = {}
    for name, binary, extra in modes:
        command = shell_prefix(extra) + f"{shlex.quote(str(binary))} {shlex.quote(str(sample))}"
        cold[name] = hyperfine(command, common.qa_root() / f"hyperfine-{name}.json", args.runs)
        row = cold[name]
        print(
            f"- {name}: mean {fmt_s(row['mean_s'])}  stddev {fmt_s(row['stddev_s'])}  "
            f"min {fmt_s(row['min_s'])}  max {fmt_s(row['max_s'])}"
        )
    print()

    print("# startup split from -stats (median of 5)")
    print("ScanAll(1) = compile + one inference. infer = (ScanAll(N)-ScanAll(1))/(N-1). compile = ScanAll(1)-infer.")
    for name, binary, extra in modes:
        split = startup_split(binary, sample, extra, reps=5, many=32)
        print(
            f"- {name}: NewScanner {fmt_s(split['new_scanner_s'])}, "
            f"compile {fmt_s(split['compile_s'])}, infer {fmt_s(split['infer_s'])}, "
            f"ScanAll(1) {fmt_s(split['scan1_s'])}, ScanAll({split['n']}) {fmt_s(split['scan_n_s'])}, "
            f"peak RSS one-file {split['peak_rss_mib_one']:.1f} MiB"
        )
    print()

    large = args.large
    if not (large / "s").is_dir() or len(list((large / "s").iterdir())) < args.small:
        print(f"generating large corpus under {large}", flush=True)
        subprocess.check_call(
            [
                sys.executable,
                str(common.repo_root() / "scripts" / "bench" / "gen_large.py"),
                "--out",
                str(large),
                "--small",
                str(args.small),
            ]
        )
    small_paths = sorted((large / "s").iterdir())[: args.small]
    print(f"# directory throughput ({len(small_paths)} small files, one CLI process)")
    for name, binary, extra in modes:
        timed = common.timed_run(
            [str(binary), "-stats", "-json", *[str(p) for p in small_paths]],
            extra_env=extra,
        )
        if timed["returncode"] != 0:
            raise SystemExit(f"{name} throughput failed\n{timed['stderr'][-2000:]}")
        stats = common.parse_stats(timed["stderr"])
        wall = timed["seconds"]
        scan = float(stats["scan_all_s"])
        print(
            f"- {name}: wall {wall:.2f} s ({len(small_paths) / wall:.1f} files/s), "
            f"ScanAll {scan:.2f} s ({len(small_paths) / scan:.1f} files/s), "
            f"NewScanner {fmt_s(float(stats['new_scanner_s']))}, "
            f"peak RSS stats {stats.get('peak_rss_mib', 0):.1f} MiB, "
            f"ru_maxrss {timed['rss_mib']:.1f} MiB, GOMAXPROCS {stats.get('gomaxprocs', '?')}"
        )
    print()

    big = sorted((large / "big").iterdir()) if (large / "big").is_dir() else []
    if big:
        print("# large files")
        for path in big:
            size_mib = path.stat().st_size / (1024 * 1024)
            for name, binary, extra in modes[:3]:
                _results, err, rc = common.run_mfile(binary, [path], extra_env=extra, stats=True)
                stats = common.parse_stats(err)
                print(
                    f"- {name} {path.name} {size_mib:.0f} MiB: "
                    f"ScanAll {fmt_s(float(stats.get('scan_all_s', 0)))} "
                    f"peak RSS {stats.get('peak_rss_mib', 0):.1f} MiB rc={rc}"
                )
        print()

    if not args.skip_matrix:
        matrix_paths = small_paths[: args.matrix_n]
        print(f"# workers x batch on {len(matrix_paths)} files (wall files/s, peak RSS MiB)")
        print("| mode | workers | batch | wall s | files/s | peak RSS MiB |")
        print("|---|---:|---:|---:|---:|---:|")
        for name, binary, extra in modes[:3]:
            for workers in (1, 4, 8):
                for batch in (1, 4, 16):
                    timed = common.timed_run(
                        [
                            str(binary),
                            "-stats",
                            "-json",
                            "-workers",
                            str(workers),
                            "-batch",
                            str(batch),
                            *[str(p) for p in matrix_paths],
                        ],
                        extra_env=extra,
                    )
                    stats = common.parse_stats(timed["stderr"])
                    rss = stats.get("peak_rss_mib", timed["rss_mib"])
                    rate = len(matrix_paths) / timed["seconds"] if timed["seconds"] else 0
                    print(
                        f"| {name} | {workers} | {batch} | {timed['seconds']:.2f} | {rate:.1f} | {float(rss):.1f} |"
                    )
        print()

    print("# file(1) and magika on the same small-file list")
    list_path = common.qa_root() / "large-files.txt"
    list_path.write_text("\n".join(str(p) for p in small_paths) + "\n", encoding="utf-8")
    file_timed = common.timed_run(["file", "-b", "-f", str(list_path)])
    print(
        f"- file -b: {file_timed['seconds']:.2f} s "
        f"({len(small_paths) / file_timed['seconds']:.1f} files/s), "
        f"ru_maxrss {file_timed['rss_mib']:.1f} MiB, rc={file_timed['returncode']}"
    )
    magika_timed = common.timed_run(["magika", "--json", *[str(p) for p in small_paths]])
    print(
        f"- magika --json: {magika_timed['seconds']:.2f} s "
        f"({len(small_paths) / magika_timed['seconds']:.1f} files/s), "
        f"ru_maxrss {magika_timed['rss_mib']:.1f} MiB, rc={magika_timed['returncode']}"
    )
    one = common.timed_run(["file", "-b", str(sample)])
    print(f"- file single file: {fmt_s(one['seconds'])}")
    one = common.timed_run(["magika", "--json", str(sample)])
    print(f"- magika single file: {fmt_s(one['seconds'])}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
